# Server
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://rays_user:rays_password@localhost:5432/rays_dynamics?schema=public"

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Device auth (separate secret used to sign device tokens issued at pairing time)
DEVICE_TOKEN_SECRET=change_this_too

# Resend (for OTP / password reset emails) — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="RAYS DYNAMICS <onboarding@resend.dev>"

# OTP
OTP_EXPIRY_MINUTES=10

# CORS
CORS_ORIGIN=*
